---
import { getServices, getSiteSettings } from '../lib/content';
import BrandMark from '../components/BrandMark.astro';
import { env } from 'node:process';
import '../styles/global.css';

const services = await getServices();
const settings = await getSiteSettings();
const phone = settings.phone || env.PUBLIC_COMPANY_PHONE;
const email = settings.email || env.PUBLIC_COMPANY_EMAIL;
const region = settings.region || env.PUBLIC_COMPANY_REGION;
const title = 'Гарант Безопасности — системы безопасности для объектов';
const description = 'Монтаж и обслуживание систем видеонаблюдения, пожарной сигнализации и контроля доступа.';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f5f2" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Гарант Безопасности — на главную">
        <span class="brand-mark" aria-hidden="true">
          <BrandMark />
        </span>
        <span class="brand-name">ГАРАНТ<br />БЕЗОПАСНОСТИ</span>
      </a>
      <nav class="main-nav" aria-label="Основная навигация">
        <a href="#services">Направления</a>
        <a href="#approach">О компании</a>
        <a href="#contact">Контакты</a>
      </nav>
      <a class="header-cta" href="#contact">Обсудить задачу <span aria-hidden="true">↗</span></a>
      <button class="menu-toggle" aria-label="Открыть меню" aria-expanded="false"><span></span><span></span></button>
    </header>

    <main id="top">
      <section class="hero section-wrap">
        <div class="hero-copy">
          <p class="eyebrow"><span class="eyebrow-dot"></span> Инженерные системы безопасности</p>
          <h1>Безопасность,<br />на которую <span>можно опереться.</span></h1>
          <p class="hero-lead">Проектируем, устанавливаем и обслуживаем системы безопасности для школ, детских садов и коммерческих объектов.</p>
          <div class="hero-actions">
            <a class="button button-dark" href="#contact">Обсудить задачу <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#services">Посмотреть направления <span aria-hidden="true">↓</span></a>
          </div>
          <div class="hero-note"><span class="note-rule"></span><span>От первого осмотра<br />до регулярного обслуживания</span></div>
        </div>
        <div class="hero-visual" aria-label="Схема систем безопасности на объекте">
          <div class="visual-topline"><span>КОМПЛЕКСНАЯ ЗАЩИТА ОБЪЕКТА</span><span>01 — 03</span></div>
          <div class="visual-grid"></div>
          <svg class="visual-art" viewBox="0 0 560 480" fill="none" role="img" aria-label="Три направления безопасности: видеонаблюдение, пожарная сигнализация и контроль доступа с металлодетекторами и турникетами">
            <path class="conduit" d="M92 240v30h134v44m54-74v74m188-74v30H334v44" />
            <circle class="conduit-node" cx="92" cy="270" r="3" /><circle class="conduit-node" cx="280" cy="270" r="3" /><circle class="conduit-node" cx="468" cy="270" r="3" />

            <rect class="device-card" x="18" y="112" width="148" height="128" rx="3" />
            <path class="camera-body" d="M64 145h38l12 9v17H76l-12-9z" />
            <path class="camera-lens" d="M114 151h10v14h-10z" />
            <path class="camera-glass" d="m124 153 12-5v20l-12-5z" />
            <text class="device-label" x="92" y="220" text-anchor="middle">ВИДЕОНАБЛЮДЕНИЕ</text>

            <rect class="device-card" x="206" y="112" width="148" height="128" rx="3" />
            <circle class="fire-detector" cx="280" cy="159" r="23" />
            <circle class="fire-detector-core" cx="280" cy="159" r="5" />
            <path class="fire-detector-mark" d="M280 136v6m0 34v6m-23-23h6m34 0h6" />
            <text class="device-label" x="280" y="220" text-anchor="middle">ПОЖАРНАЯ СИГНАЛИЗАЦИЯ</text>

            <rect class="device-card" x="394" y="112" width="148" height="128" rx="3" />
            <path class="metal-detector" d="M426 187v-40h42v40m-42-28h42" />
            <path class="metal-detector-sensor" d="M442 147v12m10-12v12" />
            <path class="turnstile" d="M493 162v25m-11-13h22m-11 0-8-8m8 8 8-8" />
            <circle class="turnstile-hub" cx="493" cy="174" r="3" />
            <text class="device-label" x="468" y="220" text-anchor="middle">КОНТРОЛЬ ДОСТУПА</text>

            <rect class="control-panel" x="226" y="314" width="108" height="108" rx="4" />
            <rect class="control-screen" x="245" y="332" width="70" height="43" rx="2" />
            <path class="control-screen-lines" d="M253 343h28m-28 8h43m-43 8h35" />
            <circle class="control-indicator" cx="252" cy="394" r="3" />
            <circle class="control-indicator secondary" cx="264" cy="394" r="3" />
            <circle class="control-indicator secondary" cx="276" cy="394" r="3" />
            <text class="control-label" x="280" y="412" text-anchor="middle">ЕДИНЫЙ КОНТРОЛЬ</text>
          </svg>
          <span class="visual-caption">Камеры · пожарная сигнализация · контроль доступа</span>
        </div>
        <div class="hero-bottom"><span>ООО «Гарант Безопасности»</span><span>Монтаж&nbsp; · &nbsp;Обслуживание&nbsp; · &nbsp;Поддержка</span></div>
      </section>

      <section class="services section-wrap" id="services">
        <div class="section-heading">
          <div><p class="eyebrow">Чем можем помочь</p><h2>Системы, которые<br />работают вместе.</h2></div>
          <p class="section-intro">Подбираем решение под задачу и особенности объекта. Состав работ и оборудование определяем после обсуждения.</p>
        </div>
        <div class="service-grid">
          {services.map((service) => (
            <article class="service-card">
              <div class="service-card-top"><span>{service.number}</span><span class="service-arrow" aria-hidden="true">↗</span></div>
              <div class="service-icon" aria-hidden="true">
                {service.number === '01' ? <svg viewBox="0 0 40 40" fill="none"><path d="M6 15.5 20 8l14 7.5v14L20 37 6 29.5v-14Z" stroke="currentColor" stroke-width="1.5"/><path d="m6 15.5 14 8 14-8M20 24v13" stroke="currentColor" stroke-width="1.5"/><circle cx="20" cy="16" r="3" stroke="currentColor" stroke-width="1.5"/></svg>
                : service.number === '02' ? <svg viewBox="0 0 40 40" fill="none"><path d="M20 5c3 7-4 9-1 14 2-4 7-5 8-10 6 6 9 12 7 19-2 7-8 10-14 10S8 34 6 27C4 20 9 13 15 9c-1 5 0 8 2 10 2-5 0-9 3-14Z" stroke="currentColor" stroke-width="1.5"/><path d="M15 28c0-3 2-6 5-8 1 3 5 5 5 9a5 5 0 1 1-10-1Z" stroke="currentColor" stroke-width="1.5"/></svg>
                : service.number === '03' ? <svg viewBox="0 0 40 40" fill="none"><path d="M10 34V9h20v25M10 16h20M10 34h20" stroke="currentColor" stroke-width="1.5"/><path d="M16 9v7m8-7v7m-4 10h9m-9 0 5-4m-5 4 5 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                : <svg viewBox="0 0 40 40" fill="none"><path d="M20 5v6m0 18v6m15-15h-6M11 20H5m25.6-10.6-4.2 4.2m-12.8 12.8-4.2 4.2m21.2 0-4.2-4.2m-12.8-12.8-4.2-4.2" stroke="currentColor" stroke-width="1.5"/><circle cx="20" cy="20" r="9" stroke="currentColor" stroke-width="1.5"/><path d="m16 20 3 3 5-6" stroke="currentColor" stroke-width="1.5"/></svg>}
              </div>
              <h3>{service.title}</h3>
              <p>{service.summary}</p>
              <a href="#contact" class="card-link">Обсудить решение <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
      </section>

      <section class="approach" id="approach">
        <div class="section-wrap approach-inner">
          <div class="approach-marker"><span class="marker-line"></span><span>ПОДХОД</span><span>01 / 03</span></div>
          <div class="approach-copy"><p class="eyebrow">Не просто поставить оборудование</p><h2>Сначала понять<br />объект. Потом —<br /><span>предложить решение.</span></h2></div>
          <div class="approach-details"><p>Каждое здание и каждая задача требуют своего подхода. Обсудим, что уже установлено, что нужно улучшить и какое обслуживание требуется.</p><a class="button button-light" href="#contact">Связаться с компанией <span aria-hidden="true">↗</span></a></div>
          <div class="approach-stamp" aria-hidden="true"><span>ГБ</span><small>ГАРАНТ<br />БЕЗОПАСНОСТИ</small></div>
        </div>
      </section>

      <section class="steps section-wrap">
        <div class="section-heading steps-heading"><div><p class="eyebrow">Понятный процесс</p><h2>От задачи<br />к работающей системе.</h2></div><p class="section-intro">Объём работ и сроки согласуем заранее — после того, как разберёмся в ситуации на объекте.</p></div>
        <div class="steps-list">
          <article><span class="step-num">01</span><div><h3>Знакомимся с задачей</h3><p>Вы рассказываете, что нужно сделать и какой это объект.</p></div><span class="step-line"></span></article>
          <article><span class="step-num">02</span><div><h3>Обсуждаем решение</h3><p>Уточняем условия, оборудование и состав работ.</p></div><span class="step-line"></span></article>
          <article><span class="step-num">03</span><div><h3>Выполняем и сопровождаем</h3><p>После монтажа можно договориться о техническом обслуживании.</p></div><span class="step-line"></span></article>
        </div>
      </section>

      <section class="contact section-wrap" id="contact">
        <div class="contact-card">
          <div class="contact-copy"><p class="eyebrow"><span class="eyebrow-dot"></span> Обсудим задачу</p><h2>Что нужно<br />защитить?</h2><p>Состав работ и оборудование подбираем под особенности объекта.</p></div>
          <div class="contact-actions">
            {phone && <a class="contact-method" href={`tel:${phone.replace(/[^+\d]/g, '')}`}><span>Позвонить</span><strong>{phone}</strong><i aria-hidden="true">↗</i></a>}
            {email && <a class="contact-method" href={`mailto:${email}`}><span>Написать на почту</span><strong>{email}</strong><i aria-hidden="true">↗</i></a>}
            {!phone && !email && <div class="contact-method contact-missing"><span>Контактные данные</span><strong>Добавим после согласования</strong></div>}
            {region && <p class="contact-region">Регион работы: {region}</p>}
          </div>
          <div class="contact-watermark" aria-hidden="true">ГБ</div>
        </div>
      </section>
    </main>

    <footer class="site-footer section-wrap"><a class="brand footer-brand" href="#top"><span class="brand-mark"><BrandMark /></span><span class="brand-name">ГАРАНТ<br />БЕЗОПАСНОСТИ</span></a><span>ООО «Гарант Безопасности»</span><span>© {new Date().getFullYear()}</span></footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('.main-nav');
      toggle?.addEventListener('click', () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!isOpen));
        nav?.classList.toggle('is-open', !isOpen);
      });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        toggle?.setAttribute('aria-expanded', 'false');
        nav?.classList.remove('is-open');
      }));
    </script>
  </body>
</html>
